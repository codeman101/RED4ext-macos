+  if Equals(key, n"VA-Cart-Confirm-Purchase") { return "Buy the items in the cart for"; };
+  if Equals(key, n"VA-Cart-Confirm-Remove") { return "Remove all items from the cart?"; };
+  if Equals(key, n"VA-Cart-Label-Checkout") { return "Cart"; };
+  if Equals(key, n"VA-Cart-Label-V") { return "Your eddies"; };
+  if Equals(key, n"VA-Cart-Remove") { return "Remove from cart"; };
+  if Equals(key, n"VA-Favorites-Add") { return "Add to favorites"; };
+  if Equals(key, n"VA-Favorites-Remove") { return "Remove from favorites"; };
+  if Equals(key, n"VA-Garment-Remove-All") { return "Remove all garments"; };
+  if Equals(key, n"VA-Garment-Remove-Preview") { return "Remove previewed garment"; };
+  if Equals(key, n"VA-No-Stores") { return "No stores available"; };
+  if Equals(key, n"VA-Preview-Disable") { return "Disable preview"; };
+  if Equals(key, n"VA-Preview-Enable") { return "Enable preview"; };
+  if Equals(key, n"VA-Preview-Item") { return "Preview"; };
+  if Equals(key, n"VA-Preview-Reset") { return "Reset preview"; };
+  if Equals(key, n"VA-Search-Bundle") { return "Search results"; };
+  if Equals(key, n"VA-Search-Filters") { return "Filters"; };
+  if Equals(key, n"VA-Search-Indicator") { return "Search"; };
+  if Equals(key, n"VA-Search-Input-Hint") { return "Search stores and items"; };
+  if Equals(key, n"VA-Search-Items-Count") { return "Items"; };
+  if Equals(key, n"VA-Search-Results") { return "Results"; };
+  if Equals(key, n"VA-Search-Stores-Count") { return "Stores"; };
+  if Equals(key, n"VA-Search-Title") { return "Search"; };
+  if Equals(key, n"VA-Tab-Name") { return "Virtual Atelier"; };
+  if Equals(key, n"VA-Virtual-Stores") { return "Virtual stores"; };
+  return text;
+}
